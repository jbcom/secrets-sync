bin/
coverage.out
*.test
.DS_Store
.coverage
.tox/
.tools/
.ruff_cache/
__pycache__/
docs/_build/
docs/apidocs/
dist/
python/build/

# agent-state: directive.md and decisions.ndjson are tracked; the rest is
# re-derivable cache and must stay out of git.
.agent-state/digest.md
.agent-state/cursor.md
.agent-state/.indexed-sha
.agent-state/.last-stop-sha
.agent-state/.last-compaction
.agent-state/batch.json

# Transient in-flight context, not a permanent doc.
CODEBASE_ASSESSMENT.md

# Credential material must never be committed. This repo synchronizes secrets,
# so its tests and docs are dense with secret-shaped placeholders; these guards
# keep a real credential from slipping in alongside them unnoticed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
